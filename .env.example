# Scam & Phishing Infrastructure Triage Workbench Configuration

# Set to true to disable live outbound network scans on public instances.
# When true, visitors can freely inspect all 3 pre-loaded real-world sample reports.
DEMO_MODE_ONLY=true

# In-memory sliding-window rate limit per client IP (requests per minute)
RATE_LIMIT_PER_MINUTE=10

# HTTP host port to bind on 127.0.0.1 (use different ports when running multiple instances)
PORT=8000

# Sub-path when reverse-proxying behind a path (e.g. /triage). Leave empty if hosted on root or dedicated subdomain.
ROOT_PATH=
